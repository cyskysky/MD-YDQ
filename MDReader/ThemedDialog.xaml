<Window x:Class="MDReader.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MD阅读器" MinWidth="400" MaxWidth="560" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        Background="{DynamicResource DlgCard}">
    <Window.Resources>
        <!-- 对话框自带浅色默认值；构造时从主窗口同步当前主题色（深色/浅色自动跟随） -->
        <SolidColorBrush x:Key="DlgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DlgTop" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DlgText" Color="#1F2328"/>
        <SolidColorBrush x:Key="DlgSubtle" Color="#59636E"/>
        <SolidColorBrush x:Key="DlgAccent" Color="#0969DA"/>
        <SolidColorBrush x:Key="DlgAccentFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DlgBorder" Color="#E1E4E8"/>
        <Style x:Key="DlgBtn" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DlgText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DlgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource DlgAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DlgAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
            <Setter Property="Background" Value="{DynamicResource DlgAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource DlgAccentFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- 独立模板：hover 只压透明度，绝不动文字色（继承基模板会把白字染成蓝字，蓝底上隐身） -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="22,20" MinWidth="400" MaxWidth="560">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="DlgBadge" Width="36" Height="32"
                    VerticalAlignment="Top" Margin="0,0,14,0" Visibility="Collapsed">
                <!-- 警告三角（圆角）：询问 / 警告用 -->
                <Path x:Name="DlgTri" Visibility="Collapsed"
                      Data="M16,6.5 L5,25.5 Q3,29 7,29 L29,29 Q33,29 31,25.5 L20,6.5 Q18,3 16,6.5 Z"/>
                <!-- 圆徽章：错误 / 信息用 -->
                <Border x:Name="DlgCirc" Width="30" Height="30" CornerRadius="15" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid>
                    <!-- 感叹号：圆角竖条 + 圆点（三角内视觉中心偏下，整体下移） -->
                    <Grid x:Name="ExclGrid" Visibility="Collapsed">
                        <Rectangle Width="4.5" Height="10" RadiusX="2.25" RadiusY="2.25"
                                   Fill="{DynamicResource DlgBadgeFg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DlgBadgeFg}"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </Grid>
                    <!-- 叉号：两根 45° 圆角短棒 -->
                    <Grid x:Name="CrossGrid" Visibility="Collapsed">
                        <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource DlgBadgeFg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource DlgBadgeFg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <!-- 信息：圆点在上、短棒在下 -->
                    <Grid x:Name="InfoGrid" Visibility="Collapsed">
                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource DlgBadgeFg}"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <Rectangle Width="4.5" Height="11" RadiusX="2.25" RadiusY="2.25"
                                   Fill="{DynamicResource DlgBadgeFg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>
                </Grid>
            </Grid>
            <TextBlock x:Name="DlgMessage" Grid.Column="1" FontSize="13.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource DlgText}" VerticalAlignment="Center"/>
            <StackPanel x:Name="DlgButtons" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0"
                        Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
