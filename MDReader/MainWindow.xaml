<Window x:Class="MDReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:MDReader"
        Title="MD阅读器" Height="800" Width="1280" MinWidth="960" MinHeight="620"
        Icon="Assets/AppIcon.ico" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True">
    <Window.Resources>
        <!-- int → 左缩进 Thickness（大纲层级） -->
        <local:IndentConverter x:Key="IndentConverter"/>
        <!-- ============ 浅色主题默认值（深色由代码切换） ============ -->
        <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#F6F8FA"/>
        <SolidColorBrush x:Key="TopBarBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2328"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#59636E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0969DA"/>
        <SolidColorBrush x:Key="AccentFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#DDF0FF"/>
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BadgeBrush" Color="#EFF1F3"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 顶栏图标按钮 -->
        <Style x:Key="TopIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（打开目录） -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 目录树节点 -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="row" CornerRadius="7" Padding="6,5" Background="Transparent"
                                    BorderThickness="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0" Width="20"
                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" Focusable="False" Cursor="Hand"
                                                  Background="Transparent" BorderThickness="0"
                                                  Foreground="{DynamicResource TextSecondary}"
                                                  ToolTip="展开 / 折叠">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <!-- 专业级人字形指示器（Segoe MDL2，与 VS Code / 资源管理器同语言） -->
                                                <Border x:Name="chevBg" Background="Transparent"
                                                        CornerRadius="5" Padding="4,5">
                                                    <TextBlock x:Name="arrow" Text="&#xE76C;"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="Text" Value="&#xE76E;"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="chevBg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" Grid.ColumnSpan="2"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 大纲条目 -->
        <Style x:Key="OutlineItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="8,5" Background="Transparent"
                                Margin="0,1">
                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                       Margin="{Binding Indent, Converter={StaticResource IndentConverter}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 历史条目 -->
        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Padding="10,8" Background="Transparent" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                        <TextBlock Text="{Binding FileCount, StringFormat=· {0}篇}" FontSize="11"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" Opacity="0.8"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Folder}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondary}" Opacity="0.85"
                                               TextTrimming="CharacterEllipsis" MaxWidth="230"
                                               ToolTip="{Binding Folder}"/>
                                    <TextBlock Text="{Binding DisplayTime}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondary}" Opacity="0.65"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" FontSize="10" Padding="7,4"
                                        Style="{StaticResource TopIconBtn}" VerticalAlignment="Center"
                                        Tag="{Binding Folder}" Click="HistoryDelete_Click"
                                        ToolTip="从历史中删除"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 全局专业滚动条：细窄圆角、无箭头按钮、颜色全部走主题资源。
              隐式样式，窗口内所有滚动条（目录树/大纲/编辑器/历史/行号）自动生效，
              白天黑夜切换时经由 DynamicResource 自动跟随，无需任何代码。
              （本程序无 Slider 控件，Thumb 隐式样式不会误伤别处。） ============ -->
        <Style TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="bar" CornerRadius="5" Margin="3,2"
                                Background="{DynamicResource BorderBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 上下箭头按钮：尺寸压零（只留透明点击区骨架），外观现代无箭头 -->
                            <RepeatButton Grid.Row="0" Height="0" MinHeight="0" Focusable="False"
                                          IsTabStop="False" Command="ScrollBar.LineUpCommand"/>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2" Height="0" MinHeight="0" Focusable="False"
                                          IsTabStop="False" Command="ScrollBar.LineDownCommand"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 横向滚动条（本程序极少出现）：仅把轨道转横，尺寸由样式触发器保证 -->
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="12"/>
                    <Setter Property="MinWidth" Value="12"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 快捷键在 MainWindow.xaml.cs 的 Window_PreviewKeyDown 中统一处理：
         Ctrl+O 打开目录 / Ctrl+F 搜索 / Ctrl+R,F5 刷新 / Ctrl+=,- 缩放 / Ctrl+D 主题 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="📖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MD阅读器" FontSize="15.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" LineHeight="18"/>
                        <TextBlock Text="MARKDOWN READER" FontSize="9" Opacity="0.55"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 当前根目录 -->
                <Border Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" MaxWidth="340"
                        Background="{DynamicResource SidebarBrush}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="RootPathText" Text="未选择目录" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="220"
                                   ToolTip="当前扫描的根目录"/>
                        <Border Margin="8,0,0,0" CornerRadius="9" Padding="7,1"
                                Background="{DynamicResource BadgeBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="FileCountBadge" Text="0 个文件" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal"/>

                <!-- 右侧操作 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIconBtn}" ToolTip="显示 / 隐藏大纲 (Ctrl+O 大纲在右侧)"
                            Click="OutlineToggle_Click" x:Name="OutlineBtn" Content="📑 大纲"/>
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,8"/>
                    <Button x:Name="ThemeBtn" Style="{StaticResource TopIconBtn}" Content="🌙 夜晚"
                            ToolTip="切换 白天 / 黑夜主题 (Ctrl+D)" Click="ThemeToggle_Click"/>
                    <Button Style="{StaticResource TopIconBtn}" Content="🔄 刷新" ToolTip="重新扫描 (Ctrl+R / F5)"
                            Click="Refresh_Click"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="📂 打开目录…"
                            ToolTip="浏览并选择要阅读的目录 (Ctrl+O)" Margin="8,0,0,0"
                            Click="OpenFolder_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主区 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="300" MinWidth="200" MaxWidth="480"/>
                <!-- rail 与 splitter 合一：整条 22px 都可拖拽调宽，中间人字形按钮负责收起/展开 -->
                <ColumnDefinition x:Name="RailCol" Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧目录栏 ===== -->
            <!-- 右框线已去掉：与 rail 右框线只留一条永久分隔线，避免 22px 间距的双线 -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderThickness="0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="目录" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TreeCountText" Text="" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 单按钮互斥切换：平时显示“全部展开”，点后全部展开并翻转为“全部收起”；
                                 无目录时禁用。比两个图标更省空间、语义唯一 -->
                            <Button x:Name="ExpandToggleBtn" Style="{StaticResource TopIconBtn}" Content="全部展开"
                                    FontSize="12" Padding="8,4"
                                    ToolTip="展开或收起全部目录" Click="ExpandToggle_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 搜索 -->
                    <Border Grid.Row="1" Margin="12,8,12,4" CornerRadius="8"
                            Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0"
                                     Background="Transparent" Padding="6,8" FontSize="12.5"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="按文件名过滤（Ctrl+F 快速定位）"/>
                            <TextBlock Grid.Column="1" Text="搜索文件名…" FontSize="12.5" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}" Opacity="0.55"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="✕" FontSize="10"
                                    Style="{StaticResource TopIconBtn}" Visibility="Collapsed"
                                    ToolTip="清空搜索" Click="ClearSearch_Click" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <!-- 树 -->
                    <TreeView x:Name="FileTree" Grid.Row="2" Margin="6,4,6,4"
                              Background="Transparent" BorderThickness="0"
                              ItemContainerStyle="{StaticResource TreeItemStyle}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="FileTree_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" MaxWidth="230">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center" Width="18" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <!-- 展开的目录用强调色，与人字形状态呼应 -->
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Margin="7,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxWidth="170">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                                            Background="{DynamicResource BadgeBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileCount}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔄 刷新目录" Click="Refresh_Click"/>
                                <MenuItem Header="📂 打开新目录…" Click="OpenFolder_Click"/>
                                <Separator/>
                                <MenuItem Header="全部展开" Click="ExpandAll_Click"/>
                                <MenuItem Header="全部折叠" Click="CollapseAll_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!-- 最近打开 -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡 拖拽打开文件夹" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Style="{StaticResource TopIconBtn}" Content="🕘 历史"
                                    ToolTip="打开历史记录，快速重开看过的目录" Click="RecentBtn_Click" x:Name="RecentBtn"
                                    Padding="8,4" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- rail 与 splitter 合一：整条 22px 都是拖拽区（调目录列↔内容区），
                 中间人字形按钮与拖拽条同级平铺、后声明置顶，只响应点击 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource SidebarBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                          Cursor="SizeWE" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="Splitter_DragCompleted"/>
            <Button x:Name="SidebarRailBtn" Grid.Column="1" Style="{StaticResource TopIconBtn}"
                    Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip="收起 / 展开目录栏 (Ctrl+B)" Click="SidebarToggle_Click" Padding="4,14"/>

            <!-- ===== 右侧内容区 ===== -->
            <Grid Grid.Column="2" Background="{DynamicResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 面包屑 + 文件操作 -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Background="{DynamicResource CardBrush}">
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 预览态：文档图标 + 文件名 -->
                            <StackPanel x:Name="CrumbPreviewBox" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="CurrentFileName" Text="欢迎使用 MD阅读器" FontSize="13.5"
                                           FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 编辑态：文件名 + 脏点 + 行列（与预览态互斥，文件名只出现一次） -->
                            <StackPanel x:Name="CrumbEditBox" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="EditFileName" Text="" FontSize="13.5" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="EditDirtyDot" Text="●" FontSize="10" Margin="7,0,0,0"
                                           VerticalAlignment="Center" Foreground="#D29922"
                                           Visibility="Collapsed" ToolTip="有未保存的更改"/>
                                <TextBlock x:Name="EditCaretText" Text="" FontSize="11.5" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock x:Name="CurrentFilePath" Text="" FontSize="11.5" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 预览态操作 -->
                            <StackPanel x:Name="CrumbPreviewActions" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TopIconBtn}" Content="✏️ 编辑" x:Name="EditToolbarBtn"
                                        ToolTip="编辑当前文档" Click="EnterEdit_Click" FontSize="12"/>
                                <Button Style="{StaticResource TopIconBtn}" Content="🗗 定位"
                                        ToolTip="在资源管理器中显示当前文件" Click="RevealInExplorer_Click" FontSize="12"/>
                                <Button Style="{StaticResource TopIconBtn}" Content="📋 路径"
                                        ToolTip="复制当前文件路径" Click="CopyPath_Click" FontSize="12"/>
                                <Button Style="{StaticResource TopIconBtn}" Content="↗ 打开"
                                        ToolTip="用系统默认程序打开当前文件" Click="OpenExternal_Click" FontSize="12"/>
                            </StackPanel>
                            <!-- 编辑态操作：排版工具 + 保存/退出（与预览态互斥） -->
                            <StackPanel x:Name="CrumbEditActions" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="加粗选中文字" Click="Format_Click" Tag="bold" Padding="6,2" x:Name="FmtBoldBtn">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="斜体" Click="Format_Click" Tag="italic" Padding="6,2">
                                    <TextBlock Text="I" FontStyle="Italic" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="删除线" Click="Format_Click" Tag="strike" Padding="6,2">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="S">
                                        <TextBlock.TextDecorations>
                                            <TextDecoration Location="Strikethrough"/>
                                        </TextBlock.TextDecorations>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="行内代码" Click="Format_Click" Tag="code" Padding="6,2">
                                    <TextBlock Text="`" FontFamily="Consolas" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="标题（# / ## / ### 循环）" Click="Format_Click" Tag="h" Padding="6,2">
                                    <TextBlock Text="#" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="引用" Click="Format_Click" Tag="quote" Padding="6,2">
                                    <TextBlock Text="&gt;" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="无序列表" Click="Format_Click" Tag="list" Padding="6,2">
                                    <TextBlock Text="•" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="代码块" Click="Format_Click" Tag="codeblock" Padding="6,2">
                                    <TextBlock Text="{}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="分隔线" Click="Format_Click" Tag="hr" Padding="6,2">
                                    <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource TopIconBtn}" ToolTip="链接" Click="Format_Click" Tag="link" Padding="6,2">
                                    <TextBlock Text="[a]" FontSize="11.5" Foreground="{DynamicResource TextPrimary}"/>
                                </Button>
                                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="5,7"/>
                                <Button x:Name="SaveEditBtn" Style="{StaticResource PrimaryBtn}"
                                        Content="💾 保存" FontSize="12" Padding="9,4"
                                        ToolTip="保存 (Ctrl+S)" Click="SaveEdit_Click"/>
                                <Button Style="{StaticResource TopIconBtn}" Content="✕"
                                        FontSize="11" Margin="4,0,0,0" Padding="8,4" x:Name="ExitEditBtn"
                                        ToolTip="退出编辑 (Esc)" Click="ExitEdit_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 预览 -->
                    <Grid Grid.Column="0">
                        <wv2:WebView2 x:Name="Preview" />
                        <!-- 加载遮罩 -->
                        <Border x:Name="LoadingMask" Background="{DynamicResource BgBrush}"
                                Visibility="Collapsed" Opacity="0.92">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="4"/>
                                <TextBlock Text="正在渲染…" Margin="0,12,0,0" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- 编辑模式：文本区（覆盖在预览上方；文件信息与工具栏已并入面包屑栏） -->
                        <Grid x:Name="EditorWrap" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 行号栏 -->
                                <Border Grid.Column="0" Width="44" Background="{DynamicResource SidebarBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                    <ScrollViewer x:Name="LineNumberScroller" VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <TextBlock x:Name="LineNumberText"
                                                   FontFamily="Consolas, Cascadia Code, Microsoft YaHei Mono"
                                                   FontSize="13.5" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                   TextAlignment="Right" Padding="0,10,8,0"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </ScrollViewer>
                                </Border>
                                <RichTextBox Grid.Column="1" x:Name="MdEditor"
                                             FontFamily="Consolas, Cascadia Code, Microsoft YaHei Mono" FontSize="13.5"
                                             Padding="10" BorderThickness="0"
                                             Background="{DynamicResource BgBrush}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             SelectionBrush="{DynamicResource SelectedBrush}"
                                             AcceptsReturn="True" AcceptsTab="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                             TextChanged="MdEditor_TextChanged"
                                             SelectionChanged="MdEditor_SelectionChanged">
                                    <RichTextBox.Resources>
                                        <Style TargetType="{x:Type Paragraph}">
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="LineHeight" Value="20"/>
                                        </Style>
                                    </RichTextBox.Resources>
                                    <FlowDocument/>
                                </RichTextBox>
                                <!-- 查找条 -->
                                <Border x:Name="FindBar" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,8,12,0" Visibility="Collapsed" Panel.ZIndex="5"
                                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8,6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="FindBox" Width="180" FontSize="12.5" Padding="6,4"
                                                 Background="{DynamicResource InputBrush}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                 KeyDown="FindBox_KeyDown" ToolTip="输入后回车查找下一个"/>
                                        <Button Style="{StaticResource TopIconBtn}" Content="下一个" FontSize="12" Margin="6,0,0,0"
                                                Click="FindNext_Click" ToolTip="查找下一个 (回车)"/>
                                        <TextBlock x:Name="FindCountText" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <Button Style="{StaticResource TopIconBtn}" Content="✕" FontSize="10" Margin="4,0,0,0"
                                                Click="FindClose_Click" ToolTip="关闭查找 (Esc)"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 大纲 -->
                    <Border x:Name="OutlinePanel" Grid.Column="1" Width="230"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="12,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📑 大纲" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource TopIconBtn}" Content="✕"
                                        FontSize="10" ToolTip="关闭大纲" Click="OutlineToggle_Click" Padding="6,3"/>
                            </Grid>
                            <ListBox x:Name="OutlineList" Grid.Row="1" Background="Transparent"
                                     BorderThickness="0" Margin="6,0,6,8"
                                     ItemContainerStyle="{StaticResource OutlineItemStyle}"
                                     SelectionChanged="OutlineList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#2DA44E"/>
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5" Margin="7,0,0,0"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 中间：字数统计 + 字号调节一体（无文档时分隔符自动隐藏） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="WordCountText" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CenterSep" Text="  ·  " FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}" Opacity="0.5"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button Style="{StaticResource TopIconBtn}" Content="A−" FontSize="11.5" Padding="6,1"
                            ToolTip="减小字号 (Ctrl+-)" Click="ZoomOut_Click" FontWeight="Bold"/>
                    <TextBlock x:Name="FontSizeLabel" Text="15" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" MinWidth="20" TextAlignment="Center"/>
                    <Button Style="{StaticResource TopIconBtn}" Content="A+" FontSize="11.5" Padding="6,1"
                            ToolTip="增大字号 (Ctrl+=)" Click="ZoomIn_Click" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="UTF-8" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Opacity="0.5"/>
                    <TextBlock x:Name="ThemeStatusText" Text="☀️ 白天模式" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Opacity="0.5"/>
                    <TextBlock Text="Markdown" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 打开历史浮层 ================= -->
        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=RecentBtn}"
               Placement="Top" HorizontalOffset="0" VerticalOffset="-8"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border x:Name="HistoryPanel" Width="320" MaxHeight="400" CornerRadius="12"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MaxHeight="250"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕘 打开历史" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="HistoryCountText" Text="" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource TopIconBtn}" Content="🧹 清空"
                                FontSize="11.5" Padding="7,3" ToolTip="清空全部打开历史"
                                Click="ClearHistory_Click"/>
                    </Grid>
                    <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource HistoryItemStyle}"
                             SelectionChanged="HistoryList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="点击条目重新打开该目录"/>
                    <TextBlock x:Name="HistoryEmptyHint" Grid.Row="1" Text="暂无历史记录&#x0a;打开过的目录会显示在这里"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Opacity="0.7"
                               TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button Grid.Row="2" Style="{StaticResource PrimaryBtn}" Content="📂 打开目录…"
                            Margin="0,8,0,2" HorizontalAlignment="Stretch"
                            Click="HistoryOpenFolder_Click"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
